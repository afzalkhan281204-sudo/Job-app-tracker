generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Change to "postgresql" in production and update DATABASE_URL
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String?
  password     String?
  applications Application[]
  createdAt    DateTime      @default(now())
}

model Company {
  id        String        @id @default(uuid())
  name      String        @unique
  website   String?
  createdAt DateTime      @default(now())
  applications Application[]
}

model Application {
  id         String    @id @default(uuid())
  role       String
  location   String?
  source     String?
  status     String    @default("applied")
  appliedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  company    Company   @relation(fields: [companyId], references: [id])
  companyId  String
  tags       Tag[]
  notes      Note[]
  attachments Attachment[]
}

model Tag {
  id           String        @id @default(uuid())
  name         String        @unique
  applications Application[]
}

model Note {
  id            String      @id @default(uuid())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String
  authorId      String?
  content       String
  createdAt     DateTime    @default(now())
}

model Attachment {
  id            String      @id @default(uuid())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String
  filename      String
  url           String
  mime          String?
  size          Int?
  createdAt     DateTime    @default(now())
}